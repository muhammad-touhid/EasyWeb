{
  "name": "easyweb-core",
  "private": true,
  "version": "1.0.0",
  "description": "EasyWeb \u2014 an open, reusable core system (page builder, auth, admin, forms) for Next.js projects. Free for anyone to use.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "publish:page-builder": "npm publish --workspace=packages/page-builder",
    "publish:auth-kit": "npm publish --workspace=packages/auth-kit",
    "publish:admin-kit": "npm publish --workspace=packages/admin-kit",
    "publish:form-system": "npm publish --workspace=packages/form-system",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "license": "MIT"
}
